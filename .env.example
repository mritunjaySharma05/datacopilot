# LLM settings
# LLM_PROVIDER: ollama (local, the Module 4 model) or groq (hosted)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192         # context window; wide schemas need room
# Groq (only when LLM_PROVIDER=groq). Key from console.groq.com; never commit it.
GROQ_API_KEY=
# GROQ_MODEL: a model id from Groq's model list (chosen 2026-11-23, see docs/notes/module5_plan.md)
GROQ_MODEL=openai/gpt-oss-120b

# Database (optional)
POSTGRES_URL=

# data.gov.in (free key from your data.gov.in account; used by scripts/download_datasets.py)
DATA_GOV_IN_API_KEY=

# AWS deployment (infra/deploy.sh; see docs/notes/handoff.md). Never commit real values.
SITE_HOSTNAME=               # e.g. myname.duckdns.org
ALARM_EMAIL=                 # alarm and budget notifications
DUCKDNS_TOKEN=               # from duckdns.org; used only by deploy.sh on your machine
BASIC_AUTH_USER=demo
BASIC_AUTH_PASSWORD=         # site login, at least 12 characters
BUDGET_USD=30
